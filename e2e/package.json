{
  "name": "@mini-workout/e2e",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "test": "pnpm test:policy",
    "test:policy": "node --test --experimental-strip-types fixtures/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:admin": "playwright test --project=admin --project=admin-mobile",
    "test:e2e:db": "playwright test --project=db",
    "test:e2e:update": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@mini-workout/eslint-config": "workspace:*",
    "@playwright/test": "catalog:test-e2e",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
