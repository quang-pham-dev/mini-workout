{
  "name": "@mini-workout/e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "check-types": "tsc --noEmit",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "test:policy": "node --test --experimental-strip-types fixtures/database-policy.test.ts fixtures/database-lock.test.ts fixtures/playwright-config.test.ts fixtures/setup-lifecycle.test.ts fixtures/metadata.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@mini-workout/eslint-config": "workspace:*",
    "@playwright/test": "catalog:test-e2e",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
