{
  "name": "@mini-workout/ui",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Shared UI component library for the Mini Workout monorepo",
  "repository": {
    "type": "git",
    "url": "https://github.com/quang-pham-dev/mini-workout.git"
  },
  "homepage": "https://github.com/quang-pham-dev/mini-workout",
  "bugs": {
    "url": "https://github.com/quang-pham-dev/mini-workout/issues"
  },
  "keywords": [
    "ui",
    "react",
    "tailwindcss",
    "shadcn",
    "component-library"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "import": "./dist/button.mjs",
      "require": "./dist/button.js"
    },
    "./data-table": {
      "types": "./dist/data-table.d.ts",
      "import": "./dist/data-table.mjs",
      "require": "./dist/data-table.js"
    },
    "./styles.css": "./src/styles/globals.css"
  },
  "files": [
    "dist",
    "src/styles/globals.css"
  ],
  "sideEffects": [
    "src/styles/globals.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "clean": "rm -rf dist node_modules",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "generate:component": "turbo gen react-component",
    "publish": "",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@mini-workout/design-system": "workspace:*",
    "@radix-ui/react-accordion": "catalog:ui-radix",
    "@radix-ui/react-label": "catalog:ui-radix",
    "@radix-ui/react-slot": "catalog:ui-radix",
    "class-variance-authority": "catalog:ui-styling",
    "clsx": "catalog:ui-styling",
    "lucide-react": "catalog:ui-styling",
    "tailwind-merge": "catalog:ui-styling",
    "tw-animate-css": "catalog:ui-styling",
    "@tanstack/react-table": "catalog:ui-data"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "devDependencies": {
    "@mini-workout/eslint-config": "workspace:*",
    "@mini-workout/prettier-config": "workspace:*",
    "@mini-workout/typescript-config": "workspace:*",
    "@mini-workout/vitest-config": "workspace:*",
    "@storybook/react": "catalog:ui-storybook",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "storybook": "catalog:ui-storybook",
    "@vitest/coverage-v8": "catalog:test-unit",
    "@vitest/ui": "catalog:test-unit",
    "eslint": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:test-unit"
  },
  "prettier": "@mini-workout/prettier-config/base"
}
