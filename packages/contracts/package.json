{
  "name": "@mini-workout/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Versioned transport contracts shared across independent Mini Workout runtimes",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./landing-migration": {
      "types": "./dist/landing-migration.d.ts",
      "import": "./dist/landing-migration.js",
      "require": "./dist/landing-migration.cjs"
    },
    "./landing-snapshot": {
      "types": "./dist/landing-snapshot.d.ts",
      "import": "./dist/landing-snapshot.js",
      "require": "./dist/landing-snapshot.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@mini-workout/eslint-config": "workspace:*",
    "@mini-workout/prettier-config": "workspace:*",
    "@mini-workout/typescript-config": "workspace:*",
    "@mini-workout/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:test-unit",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:test-unit"
  },
  "prettier": "@mini-workout/prettier-config/base"
}
