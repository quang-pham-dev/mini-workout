{
  "name": "@mini-workout/studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-sanity.mjs dev",
    "build": "node scripts/run-sanity.mjs build",
    "check-types": "tsc --noEmit",
    "cleanup:baseline-private": "node scripts/run-sanity.mjs exec scripts/cleanup-private-baseline.mjs",
    "lint": "eslint . --max-warnings 0",
    "seed:baseline": "node scripts/run-sanity.mjs exec scripts/seed-baseline.mjs",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@sanity/vision": "6.16.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanity": "6.16.0",
    "styled-components": "^6.1.15"
  },
  "devDependencies": {
    "@mini-workout/eslint-config": "workspace:*",
    "@mini-workout/prettier-config": "workspace:*",
    "@mini-workout/typescript-config": "workspace:*",
    "@mini-workout/vitest-config": "workspace:*",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitest/coverage-v8": "catalog:test-unit",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:build-vite",
    "vitest": "catalog:test-unit"
  },
  "prettier": "@mini-workout/prettier-config/base"
}
