---
import '../styles/global.css';
import CrossAppLink from '../components/CrossAppLink.astro';
import SeoHead from '../components/SeoHead.astro';
import { getContentRepository } from '../content/published-content-repository.js';
import { productDestination } from '../lib/product-destination.js';
import type { JsonLd } from '../lib/seo/index.js';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  noindex?: boolean;
  jsonLd?: JsonLd;
}

const {
  title,
  description,
  canonicalPath,
  noindex = !import.meta.env.LANDING_INDEXABLE,
  jsonLd,
} = Astro.props;
const { siteShell } = await getContentRepository(Astro.request).load();
const productLinks = productDestination(import.meta.env.MEMBER_APP_URL);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content="oklch(1 0 0)"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="oklch(0.14 0.008 250)"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="manifest" href="/manifest.webmanifest" />
    <SeoHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      noindex={noindex}
      jsonLd={jsonLd}
    />
    <script is:inline>
      if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <header class="site-header section-shell">
      <a href="/" aria-label={`${siteShell.brandName} home`}>
        <strong class="wordmark" translate="no">
          {siteShell.brandName}
          <span aria-hidden="true">.</span>
        </strong>
      </a>
      <nav class="desktop-nav" aria-label="Primary navigation">
        {siteShell.primaryLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
        <CrossAppLink
          href={productLinks.signIn}
          destinationApp="member"
          action="login"
          placement="header-desktop"
        >
          {siteShell.signInLabel}
        </CrossAppLink>
        <CrossAppLink
          class="button button-small button-primary"
          href={productLinks.register}
          destinationApp="member"
          action="register"
          placement="header-desktop"
        >
          {siteShell.primaryCtaLabel}
        </CrossAppLink>
      </nav>
      <details class="mobile-nav">
        <summary aria-label="Menu">Menu</summary>
        <nav aria-label="Mobile navigation">
          {siteShell.primaryLinks.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
          <CrossAppLink
            href={productLinks.signIn}
            destinationApp="member"
            action="login"
            placement="header-mobile"
          >
            {siteShell.signInLabel}
          </CrossAppLink>
          <CrossAppLink
            href={productLinks.register}
            destinationApp="member"
            action="register"
            placement="header-mobile"
          >
            {siteShell.primaryCtaLabel}
          </CrossAppLink>
        </nav>
      </details>
    </header>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer section-shell">
      <a href="/" aria-label={`${siteShell.brandName} home`}>
        <strong class="wordmark" translate="no">
          {siteShell.brandName}
          <span aria-hidden="true">.</span>
        </strong>
      </a>
      <span>{siteShell.footerTagline}</span>
    </footer>
  </body>
</html>
