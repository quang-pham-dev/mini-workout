{
  "name": "@mini-workout/landing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node --env-file-if-exists=.env --import tsx scripts/write-vercel-output.ts",
    "preview": "astro preview",
    "start": "astro preview --host 0.0.0.0",
    "check-boundaries": "node scripts/check-boundaries.mjs",
    "check-budget": "node scripts/check-budget.mjs",
    "check-indexing-build": "node scripts/check-indexing-build.mjs",
    "check-experiment-readiness": "node --import tsx scripts/check-experiment-readiness.ts",
    "check-launch-readiness": "node --env-file-if-exists=.env --import tsx scripts/check-content-launch-readiness.ts",
    "check-operations": "node --env-file-if-exists=.env --import tsx scripts/check-operations.ts",
    "check-rollout": "node --env-file-if-exists=.env --import tsx scripts/check-rollout.ts",
    "check-content-parity": "node --env-file-if-exists=.env --import tsx scripts/check-sanity-parity.ts",
    "check-types": "astro check",
    "prelint": "pnpm check-boundaries",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts' 'scripts/**/*.ts' astro.config.mjs vitest.config.ts --max-warnings 0",
    "format": "prettier --plugin prettier-plugin-astro --check .",
    "format:fix": "prettier --plugin prettier-plugin-astro --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@astrojs/vercel": "11.0.11",
    "@mini-workout/analytics": "workspace:*",
    "@mini-workout/observability": "workspace:*",
    "@sanity/client": "8.7.0",
    "@sanity/preview-url-secret": "4.1.5",
    "@sanity/visual-editing": "6.1.2",
    "astro": "7.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@mini-workout/design-system": "workspace:*",
    "@mini-workout/eslint-config": "workspace:*",
    "@mini-workout/prettier-config": "workspace:*",
    "@mini-workout/typescript-config": "workspace:*",
    "@mini-workout/vitest-config": "workspace:*",
    "@tailwindcss/vite": "catalog:ui-styling",
    "@vitest/coverage-v8": "catalog:test-unit",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-astro": "1.0.1",
    "tailwindcss": "catalog:ui-styling",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:test-unit"
  },
  "prettier": "@mini-workout/prettier-config/base"
}
