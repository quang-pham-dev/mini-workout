# Canonical origin for the public Astro site. Set the production hostname in Vercel.
LANDING_SITE_URL=https://example.com
# Product/member app origin used to derive /login and /register destinations.
MEMBER_APP_URL=http://localhost:3000
# Enable only after approved content is deployed to the production Vercel environment.
LANDING_INDEXING_ENABLED=false
# Keep fixtures until the published Sanity dataset passes parity checks.
LANDING_CONTENT_SOURCE=fixtures
# `static` is the public artifact. `preview` builds a separate protected SSR deployment.
LANDING_OUTPUT=static
# Non-essential analytics stays disabled unless both this flag and the public key are set.
# The browser still requires mini-workout:analytics-consent=granted before loading PostHog.
LANDING_ANALYTICS_ENABLED=false
# Global experiment kill switch. Requires analytics and approved consent UI.
LANDING_EXPERIMENTS_ENABLED=false
LANDING_POSTHOG_KEY=
LANDING_POSTHOG_HOST=https://us.i.posthog.com
# Required only when LANDING_CONTENT_SOURCE=sanity. Both values are non-secret.
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Preview deployment only. Server-side viewer token; never prefix with PUBLIC_ or expose to Vite.
SANITY_API_READ_TOKEN=
# Non-secret Studio origin used by preview stega links.
SANITY_STUDIO_URL=http://localhost:3333
# Preview/automation deployment only. Random webhook signing secret configured in Sanity.
SANITY_WEBHOOK_SECRET=
# Preview/automation deployment only. Treat the full Vercel Deploy Hook URL as a secret.
VERCEL_DEPLOY_HOOK_URL=
