{
  "name": "@mini-workout/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3001",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "check-env": "node scripts/check-env.mjs",
    "check-artifact": "node scripts/check-artifact.mjs",
    "start": "pnpm check-env && node .output/server/index.mjs",
    "check-types": "tsr generate && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@mini-workout/auth": "workspace:*",
    "@mini-workout/core": "workspace:*",
    "@mini-workout/design-system": "workspace:*",
    "@mini-workout/observability": "workspace:*",
    "@mini-workout/ui": "workspace:*",
    "@tanstack/react-query": "catalog:tanstack-admin",
    "@tanstack/react-query-devtools": "catalog:tanstack-admin",
    "@tanstack/react-router": "catalog:tanstack-admin",
    "@tanstack/react-router-devtools": "catalog:tanstack-admin",
    "@tanstack/react-router-ssr-query": "catalog:tanstack-admin",
    "@tanstack/react-start": "catalog:tanstack-admin",
    "better-auth": "catalog:better-auth",
    "nitro": "catalog:tanstack-admin",
    "posthog-js": "catalog:analysis",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@mini-workout/eslint-config": "workspace:*",
    "@mini-workout/prettier-config": "workspace:*",
    "@mini-workout/typescript-config": "workspace:*",
    "@mini-workout/vitest-config": "workspace:*",
    "@prisma/client": "6.19.3",
    "@tailwindcss/postcss": "catalog:ui-styling",
    "@tailwindcss/vite": "catalog:ui-styling",
    "@tanstack/router-cli": "catalog:tanstack-admin",
    "@testing-library/jest-dom": "catalog:test-unit",
    "@testing-library/react": "catalog:test-unit",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:tanstack-admin",
    "@vitest/coverage-v8": "catalog:test-unit",
    "eslint": "catalog:",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "postcss": "catalog:ui-styling",
    "prettier": "catalog:",
    "tailwindcss": "catalog:ui-styling",
    "typescript": "catalog:",
    "vite": "catalog:tanstack-admin",
    "vitest": "catalog:test-unit"
  },
  "prettier": "@mini-workout/prettier-config/base"
}
