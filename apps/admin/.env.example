DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3102"

# Server-side auth email delivery. Leave empty until a verified sender/domain
# is configured; missing credentials fail safely and never enable verification.
AUTH_EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
RESEND_API_URL="https://api.resend.com"
AUTH_EMAIL_FROM="Mini Workout <no-reply@example.com>"

# Browser-only PostHog project key. Leave empty to disable telemetry locally.
ADMIN_POSTHOG_KEY=""
ADMIN_POSTHOG_HOST="https://us.i.posthog.com"
ADMIN_POSTHOG_ENABLED="true"
ADMIN_POSTHOG_REQUIRE_CONSENT="false"
# Server-side PostHog error reporting key; never expose it to the browser.
ADMIN_POSTHOG_SERVER_API_KEY=""
