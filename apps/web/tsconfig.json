{
  "extends": "@mini-workout/typescript-config/nextjs-library.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "next-env.d.ts",
    "next.config.ts",
    ".next-build/types/**/*.ts"
  ],
  "exclude": ["node_modules", "vitest.config.ts"]
}
