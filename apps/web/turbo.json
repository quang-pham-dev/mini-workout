{
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_EXTENDS$", ".env", ".env.*"],
      "env": [
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "DATABASE_URL",
        "NEXT_PUBLIC_API_URL",
        "POSTHOG_SERVER_API_KEY",
        "POSTHOG_HOST",
        "POSTHOG_ENABLED",
        "POSTHOG_REQUIRE_CONSENT"
      ],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "format": {
      "extends": false
    },
    "lint": {
      "env": [
        "BETTER_AUTH_URL",
        "NODE_ENV",
        "POSTHOG_SERVER_API_KEY",
        "POSTHOG_HOST",
        "POSTHOG_ENABLED",
        "POSTHOG_REQUIRE_CONSENT"
      ]
    },
    "test": {
      "extends": false
    }
  }
}
