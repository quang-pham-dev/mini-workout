{
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["@mini-workout/ui#build"],
      "inputs": ["$TURBO_EXTENDS$", ".env", ".env.*"],
      "env": [
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "DATABASE_URL",
        "NEXT_PUBLIC_API_URL"
      ],
      "outputs": [
        ".next-build/**",
        "!.next-build/cache/**",
        "!.next-build/dev/**"
      ]
    },
    "format": {
      "extends": false
    },
    "lint": {
      "env": ["BETTER_AUTH_URL", "NODE_ENV"]
    },
    "test": {
      "extends": false
    }
  }
}
