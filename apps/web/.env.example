# Generate with: pnpm dlx auth@latest secret
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# PostgreSQL connection used by Prisma.
DATABASE_URL="postgresql://user:password@host:5432/mini_workout?sslmode=require"

# Browser-only PostHog project key. Leave empty to disable telemetry locally.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
NEXT_PUBLIC_POSTHOG_ENABLED="true"
NEXT_PUBLIC_POSTHOG_REQUIRE_CONSENT="false"
POSTHOG_SERVER_API_KEY=""
POSTHOG_HOST="https://us.i.posthog.com"
