# Generate with: pnpm dlx auth@latest secret
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Local/test uses the deterministic local provider. Production defaults to
# PostHog when this variable is omitted. Set explicitly in deployment config.
AUTH_FEATURE_FLAG_PROVIDER="local"
# Used only by the local provider; PostHog never treats this as an override.
MW_FEATURE_AUTH_EMAIL_VERIFICATION="0"
RESEND_API_KEY=""
AUTH_EMAIL_FROM="Mini Workout <no-reply@example.com>"

# PostgreSQL connection used by Prisma.
DATABASE_URL="postgresql://user:password@host:5432/mini_workout?sslmode=require"

# Browser-only PostHog project key. Leave empty to disable telemetry locally.
POSTHOG_KEY=""
POSTHOG_HOST="https://us.i.posthog.com"
POSTHOG_ENABLED="true"
POSTHOG_REQUIRE_CONSENT="false"
POSTHOG_SERVER_API_KEY=""
POSTHOG_AUTH_EMAIL_VERIFICATION_FLAG_KEY="auth-email-verification"
