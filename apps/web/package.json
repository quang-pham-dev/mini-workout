{
  "name": "@mini-workout/web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "analyze": "next build && next experimental-analyze",
    "check-types": "next typegen && tsc --noEmit",
    "clean": "rm -rf .next && rm -rf node_modules",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "auth:generate": "pnpm dlx auth@latest generate --output ../../packages/database/prisma/schema.prisma"
  },
  "dependencies": {
    "@mini-workout/auth": "workspace:*",
    "@mini-workout/core": "workspace:*",
    "@mini-workout/database": "workspace:*",
    "@mini-workout/observability": "workspace:*",
    "@mini-workout/ui": "workspace:*",
    "better-auth": "1.7.1",
    "eslint-plugin-boundaries": "^7.2.0",
    "lucide-react": "^1.42.0",
    "next": "catalog:",
    "posthog-js": "^1.433.7",
    "react": "catalog:",
    "react-dom": "catalog:",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@mini-workout/design-system": "workspace:*",
    "@mini-workout/eslint-config": "workspace:*",
    "@mini-workout/typescript-config": "workspace:*",
    "@mini-workout/vitest-config": "workspace:*",
    "@tailwindcss/postcss": "catalog:ui-styling",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:test-unit",
    "eslint": "catalog:",
    "eslint-import-resolver-typescript": "^4.4.5",
    "postcss": "catalog:ui-styling",
    "tailwindcss": "catalog:ui-styling",
    "typescript": "catalog:",
    "vitest": "catalog:test-unit"
  }
}
