{
  "name": "@mini-workout/web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "postinstall": "prisma generate",
    "analyze": "next build && next experimental-analyze",
    "check-types": "next typegen && tsc --noEmit",
    "clean": "rm -rf .next && rm -rf node_modules",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "auth:generate": "pnpm dlx auth@latest generate --output prisma/schema.prisma",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.1",
    "@better-auth/utils": "0.4.2",
    "@mini-workout/observability": "workspace:*",
    "@mini-workout/ui": "workspace:*",
    "@prisma/client": "6.19.3",
    "better-auth": "1.7.1",
    "eslint-plugin-boundaries": "^7.2.0",
    "lucide-react": "^1.42.0",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@mini-workout/design-system": "workspace:*",
    "@mini-workout/eslint-config": "workspace:*",
    "@mini-workout/typescript-config": "workspace:*",
    "@mini-workout/vitest-config": "workspace:*",
    "@tailwindcss/postcss": "catalog:ui-styling",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:test-unit",
    "eslint": "catalog:",
    "postcss": "catalog:ui-styling",
    "prisma": "6.19.3",
    "tailwindcss": "catalog:ui-styling",
    "tsx": "^4.19.2",
    "typescript": "catalog:",
    "vitest": "catalog:test-unit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
