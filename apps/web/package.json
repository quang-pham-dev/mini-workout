{
  "name": "web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "check-types": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "auth:generate": "pnpm dlx auth@latest generate --output prisma/schema.prisma",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@mini-workout/observability": "workspace:*",
    "@mini-workout/ui": "workspace:*",
    "@better-auth/prisma-adapter": "1.7.1",
    "@better-auth/utils": "0.4.2",
    "@prisma/client": "6.19.3",
    "better-auth": "1.7.1",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@mini-workout/eslint-config": "workspace:*",
    "@mini-workout/typescript-config": "workspace:*",
    "@mini-workout/vitest-config": "workspace:*",
    "@vitest/coverage-v8": "catalog:test-unit",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "prisma": "6.19.3",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:test-unit"
  }
}
