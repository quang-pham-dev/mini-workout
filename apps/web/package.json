    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "next-auth": "5.0.0-beta.32",
    "zod": "4.4.3",
    "@vitest/coverage-v8": "catalog:test-unit",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
