HOST=0.0.0.0
PORT=1337
PUBLIC_URL=http://localhost:1337
CMS_VALIDATE_RUNTIME_CONFIG=false

# Development defaults to SQLite. Production must set DATABASE_CLIENT=postgres
# and provide either DATABASE_URL or the discrete PostgreSQL settings below.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
DATABASE_URL=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=mini_workout_cms
DATABASE_USERNAME=mini_workout_cms
DATABASE_PASSWORD=
DATABASE_SCHEMA=public
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Generate unique high-entropy values per environment. Never commit real values.
APP_KEYS=replace-with-four-comma-separated-keys
API_TOKEN_SALT=replace-me
ADMIN_JWT_SECRET=replace-me
TRANSFER_TOKEN_SALT=replace-me
JWT_SECRET=replace-me
ENCRYPTION_KEY=replace-me

# Landing preview integration.
LANDING_PREVIEW_URL=http://localhost:4321
STRAPI_PREVIEW_SECRET=replace-me

# Publication delivery.
STRAPI_WEBHOOK_TOKEN=replace-me
