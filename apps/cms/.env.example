HOST=0.0.0.0
PORT=1337
PUBLIC_URL=http://localhost:1337
CMS_VALIDATE_RUNTIME_CONFIG=false

# Development defaults to SQLite. Production must set DATABASE_CLIENT=postgres
# and provide either DATABASE_URL or the discrete PostgreSQL settings below.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
DATABASE_URL=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=mini_workout_cms
DATABASE_USERNAME=mini_workout_cms
DATABASE_PASSWORD=
DATABASE_SCHEMA=public
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Generate unique high-entropy values per environment. Never commit real values.
APP_KEYS=replace-with-four-comma-separated-keys
API_TOKEN_SALT=replace-me
ADMIN_JWT_SECRET=replace-me
TRANSFER_TOKEN_SALT=replace-me
JWT_SECRET=replace-me
ENCRYPTION_KEY=replace-me

# Landing preview integration.
LANDING_PREVIEW_URL=http://localhost:4321
STRAPI_PREVIEW_SECRET=replace-me

# Durable Strapi publication outbox -> protected Landing automation endpoint.
LANDING_PUBLISH_WEBHOOK_URL=http://localhost:4321/api/webhooks/strapi/publish
STRAPI_WEBHOOK_SIGNING_SECRET=local-only-publish-signing-secret-change-before-deploy-00000000

# Dedicated custom Content API token for the one-time migration CLI. Grant only
# find/create/update plus Upload find/upload. Remove it after migration cutover.
STRAPI_API_URL=http://localhost:1337
STRAPI_MIGRATION_TOKEN=

# Media storage. Local development uses Strapi's local provider. Production
# validation requires R2 so container restarts cannot lose uploaded assets.
CMS_UPLOAD_PROVIDER=local
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=mini-workout-cms
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=https://media.example.com
R2_ROOT_PATH=landing
