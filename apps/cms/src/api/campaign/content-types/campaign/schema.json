{
  "kind": "collectionType",
  "collectionName": "campaigns",
  "info": {
    "singularName": "campaign",
    "pluralName": "campaigns",
    "displayName": "Campaign"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "schemaVersion": {
      "type": "integer",
      "required": true,
      "default": 1,
      "min": 1,
      "max": 1
    },
    "campaignId": {
      "type": "uid",
      "required": true,
      "unique": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "audienceDescription": {
      "type": "text",
      "required": true
    },
    "startsAt": {
      "type": "datetime",
      "required": true
    },
    "endsAt": {
      "type": "datetime",
      "required": true
    },
    "expiryPolicy": {
      "type": "component",
      "component": "campaign.expiry-policy",
      "repeatable": false,
      "required": true
    },
    "sections": {
      "type": "dynamiczone",
      "components": [
        "campaign.hero-v1",
        "campaign.benefits-v1",
        "campaign.faq-v1",
        "campaign.cta-v1"
      ],
      "required": true,
      "min": 1
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "required": true
    }
  }
}
