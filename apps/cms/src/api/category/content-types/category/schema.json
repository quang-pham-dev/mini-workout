{
  "kind": "collectionType",
  "collectionName": "categories",
  "info": {
    "singularName": "category",
    "pluralName": "categories",
    "displayName": "Category"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "schemaVersion": {
      "type": "integer",
      "required": true,
      "default": 1,
      "min": 1,
      "max": 1
    },
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "eyebrow": {
      "type": "string",
      "required": true
    },
    "headline": {
      "type": "string",
      "required": true
    },
    "introduction": {
      "type": "text",
      "required": true
    },
    "backlink": {
      "type": "component",
      "component": "shared.internal-link",
      "repeatable": false,
      "required": true
    },
    "image": {
      "type": "component",
      "component": "shared.editorial-media",
      "repeatable": false,
      "required": true
    },
    "focusHeading": {
      "type": "string",
      "required": true
    },
    "focusIntroduction": {
      "type": "text",
      "required": true
    },
    "focuses": {
      "type": "component",
      "component": "category.focus-v1",
      "repeatable": true,
      "required": true,
      "min": 1
    },
    "closingHeading": {
      "type": "string",
      "required": true
    },
    "closingCopy": {
      "type": "text",
      "required": true
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "required": true
    },
    "articles": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::article.article",
      "mappedBy": "category"
    }
  }
}
