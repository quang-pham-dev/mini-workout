{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [],
  "globalEnv": [
    "NODE_ENV",
    "BETTER_AUTH_SECRET",
    "DATABASE_URL",
    "E2E_DATABASE_URL",
    "BETTER_AUTH_URL",
    "BETTER_AUTH_TRUSTED_ORIGINS",
    "PLAYWRIGHT_HTML_OUTPUT_DIR",
    "PLAYWRIGHT_OUTPUT_DIR",
    "POSTHOG_SERVER_API_KEY",
    "ADMIN_POSTHOG_SERVER_API_KEY",
    "POSTHOG_AUTH_EMAIL_VERIFICATION_FLAG_KEY",
    "POSTHOG_KEY",
    "POSTHOG_HOST",
    "POSTHOG_ENABLED",
    "POSTHOG_REQUIRE_CONSENT",
    "ADMIN_POSTHOG_KEY",
    "ADMIN_POSTHOG_HOST",
    "ADMIN_POSTHOG_ENABLED",
    "ADMIN_POSTHOG_REQUIRE_CONSENT",
    "AUTH_FEATURE_FLAG_PROVIDER",
    "MW_FEATURE_AUTH_EMAIL_VERIFICATION",
    "RESEND_API_KEY",
    "RESEND_API_URL",
    "AUTH_EMAIL_FROM"
  ],
  "globalPassThroughEnv": ["CI"],
  "ui": "tui",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [
        "dist/**",
        "build/**",
        ".output/**",
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ]
    },
    "format": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.prettierrc*",
        "$TURBO_ROOT$/prettier.config.*"
      ]
    },
    "format:fix": {
      "cache": false
    },
    "lint": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "eslint.config.*", ".eslintignore"]
    },
    "lint:fix": {
      "cache": false
    },
    "check-types": {
      "dependsOn": ["^build", "transit"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig*.json"]
    },
    "check-budget": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "check-content-parity": {
      "env": ["SANITY_DATASET", "SANITY_PROJECT_ID"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "start": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "test:watch": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "test:e2e": {
      "dependsOn": ["@mini-workout/web#build", "@mini-workout/admin#build"],
      "env": ["E2E_PUBLIC_PORT", "E2E_DATABASE_PORT", "E2E_ADMIN_PORT"],
      "cache": false
    },
    "test:e2e:landing": {
      "dependsOn": ["@mini-workout/landing#build"],
      "env": [
        "E2E_LANDING_PORT",
        "LANDING_INDEXING_ENABLED",
        "VERCEL_ENV",
        "PLAYWRIGHT_HTML_OUTPUT_DIR",
        "PLAYWRIGHT_OUTPUT_DIR"
      ],
      "cache": false
    },
    "test:e2e:admin": {
      "dependsOn": ["@mini-workout/web#build", "@mini-workout/admin#build"],
      "env": ["E2E_PUBLIC_PORT", "E2E_DATABASE_PORT", "E2E_ADMIN_PORT"],
      "cache": false
    },
    "test:e2e:db": {
      "dependsOn": ["@mini-workout/web#build"],
      "env": ["E2E_PUBLIC_PORT", "E2E_DATABASE_PORT", "E2E_ADMIN_PORT"],
      "cache": false
    }
  }
}
