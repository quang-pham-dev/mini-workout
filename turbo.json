{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [],
  "globalEnv": [
    "NODE_ENV",
    "BETTER_AUTH_SECRET",
    "DATABASE_URL",
    "BETTER_AUTH_URL"
  ],
  "globalPassThroughEnv": ["CI"],
  "ui": "tui",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**", "build/**", ".next-build/**"]
    },
    "format": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.prettierrc*",
        "$TURBO_ROOT$/prettier.config.*"
      ]
    },
    "format:fix": {
      "cache": false
    },
    "lint": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "eslint.config.*", ".eslintignore"]
    },
    "lint:fix": {
      "cache": false
    },
    "check-types": {
      "dependsOn": ["^build", "transit"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig*.json"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "start": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "test:watch": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "test:e2e": {
      "dependsOn": ["@mini-workout/web#build"],
      "cache": false
    }
  }
}
